<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>圖片格式轉換神器 (HEIC/WebP/JFIF 轉 JPG/PNG)</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- heic2any Library for HEIC support -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/heic2any/0.0.4/heic2any.min.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&display=swap');
        
        body {
            font-family: 'Noto Sans TC', sans-serif;
            background-color: #f3f4f6;
        }

        /* 自定義拖放區域動畫 */
        .drag-active {
            border-color: #3b82f6;
            background-color: #eff6ff;
            transform: scale(1.02);
        }

        .loader {
            border: 3px solid #f3f3f3;
            border-radius: 50%;
            border-top: 3px solid #3b82f6;
            width: 24px;
            height: 24px;
            -webkit-animation: spin 1s linear infinite; /* Safari */
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* 隱藏滾動條但保持功能 */
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="min-h-screen text-slate-800 flex flex-col">

    <!-- Navbar -->
    <nav class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center gap-3">
                    <div class="bg-blue-600 text-white p-2 rounded-lg">
                        <i class="fa-solid fa-images text-xl"></i>
                    </div>
                    <span class="font-bold text-xl tracking-wide text-gray-800">圖片格式轉換器</span>
                </div>
                <div class="text-sm text-gray-500 hidden sm:block">
                    支援 HEIC, WebP, JFIF 轉 JPG/PNG
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow max-w-5xl mx-auto w-full px-4 py-8 sm:px-6 lg:px-8">
        
        <!-- Controls Area -->
        <div class="bg-white rounded-2xl shadow-lg p-6 mb-8 transition-all duration-300">
            <h2 class="text-lg font-semibold mb-4 flex items-center gap-2">
                <i class="fa-solid fa-sliders text-blue-500"></i> 設定輸出格式
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Format Selection -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">目標格式</label>
                    <div class="flex gap-4">
                        <label class="cursor-pointer">
                            <input type="radio" name="format" value="image/jpeg" checked class="peer sr-only">
                            <div class="px-4 py-2 rounded-lg border-2 border-gray-200 peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:text-blue-700 transition-all text-center w-full hover:bg-gray-50">
                                <span class="font-bold">JPG / JPEG</span>
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="format" value="image/png" class="peer sr-only">
                            <div class="px-4 py-2 rounded-lg border-2 border-gray-200 peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:text-blue-700 transition-all text-center w-full hover:bg-gray-50">
                                <span class="font-bold">PNG</span>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Quality Selection (Only for JPG/WEBP really, but useful generally) -->
                <div id="quality-container">
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        圖片品質: <span id="quality-value" class="text-blue-600 font-bold">90%</span>
                    </label>
                    <input type="range" id="quality" min="0.1" max="1.0" step="0.1" value="0.9" 
                        class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-blue-600">
                    <div class="flex justify-between text-xs text-gray-400 mt-1">
                        <span>低檔案大小</span>
                        <span>高畫質</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Drop Zone -->
        <div id="drop-zone" class="relative group cursor-pointer">
            <input type="file" id="file-input" class="hidden" multiple accept="image/*,.heic,.heif,.jfjf">
            
            <div class="border-3 border-dashed border-gray-300 rounded-3xl p-10 text-center transition-all duration-300 bg-white hover:border-blue-400 hover:bg-blue-50 flex flex-col items-center justify-center min-h-[250px]">
                
                <div class="w-20 h-20 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mb-6 text-3xl transition-transform duration-300 group-hover:scale-110">
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                </div>
                
                <h3 class="text-xl font-bold text-gray-700 mb-2">點擊或拖放圖片至此</h3>
                <p class="text-gray-500 text-sm max-w-md mx-auto">
                    支援 JPG, PNG, GIF, <span class="text-blue-600 font-medium bg-blue-50 px-1 rounded">HEIC</span>, <span class="text-blue-600 font-medium bg-blue-50 px-1 rounded">WebP</span>, <span class="text-blue-600 font-medium bg-blue-50 px-1 rounded">JFIF</span>
                </p>
            </div>
        </div>

        <!-- Processing List -->
        <div id="results-area" class="mt-8 hidden">
            <div class="flex justify-between items-end mb-4">
                <h2 class="text-xl font-bold text-gray-800">
                    轉換列表 <span id="count-badge" class="bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-0.5 rounded ml-2">0</span>
                </h2>
                <button id="clear-all" class="text-sm text-red-500 hover:text-red-700 hover:underline">
                    清除全部
                </button>
            </div>

            <div id="image-list" class="grid grid-cols-1 gap-4">
                <!-- Items will be injected here via JS -->
            </div>
        </div>

    </main>

    <footer class="bg-white border-t border-gray-200 mt-auto py-6">
        <div class="max-w-5xl mx-auto px-4 text-center text-gray-500 text-sm">
            &copy; 2024 圖片格式轉換器 | 完全在您的瀏覽器端執行，不會上傳圖片至伺服器。
        </div>
    </footer>

    <!-- JavaScript Logic -->
    <script>
        const dropZone = document.getElementById('drop-zone');
        const fileInput = document.getElementById('file-input');
        const imageList = document.getElementById('image-list');
        const resultsArea = document.getElementById('results-area');
        const qualityInput = document.getElementById('quality');
        const qualityValue = document.getElementById('quality-value');
        const countBadge = document.getElementById('count-badge');
        const clearAllBtn = document.getElementById('clear-all');
        const formatInputs = document.getElementsByName('format');

        let filesQueue = [];

        // Quality Slider UI update
        qualityInput.addEventListener('input', (e) => {
            qualityValue.textContent = `${Math.round(e.target.value * 100)}%`;
        });

        // Toggle Quality slider visibility based on format (PNG is lossless, quality mostly affects compression speed not artifacts, but standard browsers usually ignore quality param for PNG)
        // We will keep it visible but maybe gray out or just leave it as is for simplicity.

        // --- Drag & Drop Handlers ---
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, preventDefaults, false);
        });

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, highlight, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, unhighlight, false);
        });

        function highlight(e) {
            dropZone.firstElementChild.nextElementSibling.classList.add('drag-active');
        }

        function unhighlight(e) {
            dropZone.firstElementChild.nextElementSibling.classList.remove('drag-active');
        }

        dropZone.addEventListener('drop', handleDrop, false);
        dropZone.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', handleFiles);

        function handleDrop(e) {
            const dt = e.dataTransfer;
            const files = dt.files;
            processFiles(files);
        }

        function handleFiles() {
            const files = this.files;
            processFiles(files);
            this.value = ''; // Reset input so same file can be selected again
        }

        // --- Core Processing Logic ---
        function processFiles(files) {
            if (files.length > 0) {
                resultsArea.classList.remove('hidden');
            }

            Array.from(files).forEach(file => {
                createImageCard(file);
            });
        }

        async function createImageCard(file) {
            // Generate unique ID
            const id = 'img-' + Date.now() + Math.random().toString(36).substr(2, 9);
            const targetFormat = document.querySelector('input[name="format"]:checked').value;
            const quality = parseFloat(qualityInput.value);

            // Determine extension
            let ext = targetFormat === 'image/jpeg' ? 'jpg' : 'png';
            
            // UI Structure
            const card = document.createElement('div');
            card.className = "bg-white p-4 rounded-xl shadow-sm border border-gray-200 flex flex-col sm:flex-row items-center gap-4 transition-all hover:shadow-md";
            card.id = id;

            card.innerHTML = `
                <div class="w-full sm:w-24 h-24 bg-gray-100 rounded-lg flex items-center justify-center overflow-hidden shrink-0 relative">
                    <div id="preview-${id}" class="w-full h-full bg-cover bg-center opacity-50"></div>
                    <div id="loader-${id}" class="absolute inset-0 flex items-center justify-center">
                        <div class="loader"></div>
                    </div>
                </div>
                
                <div class="flex-grow w-full text-center sm:text-left min-w-0">
                    <h4 class="font-bold text-gray-800 truncate" title="${file.name}">${file.name}</h4>
                    <p class="text-xs text-gray-500 mb-2">原始大小: ${formatBytes(file.size)}</p>
                    <div class="flex flex-wrap gap-2 justify-center sm:justify-start" id="status-${id}">
                        <span class="text-xs bg-blue-100 text-blue-600 px-2 py-1 rounded-full animate-pulse">轉換中...</span>
                    </div>
                </div>

                <div class="flex gap-2 w-full sm:w-auto mt-2 sm:mt-0">
                    <a id="download-${id}" class="hidden flex-1 sm:flex-none justify-center items-center gap-2 bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-sm shadow-green-200" download>
                        <i class="fa-solid fa-download"></i> 下載
                    </a>
                    <button onclick="removeCard('${id}')" class="text-gray-400 hover:text-red-500 p-2 rounded-lg hover:bg-red-50 transition-colors">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>
            `;

            imageList.prepend(card);
            updateCount();

            try {
                // 1. Convert/Load Logic
                let imageSource;
                let originalFileName = file.name;
                
                // Remove extension from name
                let nameWithoutExt = originalFileName.substring(0, originalFileName.lastIndexOf('.')) || originalFileName;

                // HEIC Handling
                if (file.name.toLowerCase().endsWith('.heic') || file.type === 'image/heic') {
                    console.log("Detecting HEIC...");
                    try {
                        const blob = await heic2any({
                            blob: file,
                            toType: targetFormat,
                            quality: quality
                        });
                        // heic2any might return an array if multiple images in one file, take first
                        imageSource = Array.isArray(blob) ? blob[0] : blob;
                    } catch (e) {
                        throw new Error("HEIC 轉換失敗，請確認檔案是否損毀。");
                    }
                } else {
                    // Standard formats (including webp, jfjf)
                    imageSource = file;
                }

                // 2. Draw to Canvas to convert format strictly
                const dataUrl = await convertToDataUrl(imageSource, targetFormat, quality);
                
                // 3. Update UI
                const previewDiv = document.getElementById(`preview-${id}`);
                const loader = document.getElementById(`loader-${id}`);
                const statusDiv = document.getElementById(`status-${id}`);
                const downloadBtn = document.getElementById(`download-${id}`);

                // Set preview
                previewDiv.style.backgroundImage = `url(${dataUrl})`;
                previewDiv.classList.remove('opacity-50');
                loader.classList.add('hidden');

                // Update Status
                const resultSize = Math.round((dataUrl.length * 3) / 4); // Approx size from base64
                statusDiv.innerHTML = `
                    <span class="text-xs bg-green-100 text-green-700 px-2 py-1 rounded-full">
                        <i class="fa-solid fa-check"></i> 完成
                    </span>
                    <span class="text-xs text-gray-400 border border-gray-200 px-2 py-1 rounded-full">
                        轉為 ${ext.toUpperCase()}
                    </span>
                `;

                // Configure Download
                downloadBtn.href = dataUrl;
                downloadBtn.download = `${nameWithoutExt}_converted.${ext}`;
                downloadBtn.classList.remove('hidden');
                downloadBtn.classList.add('flex');

            } catch (error) {
                console.error(error);
                const statusDiv = document.getElementById(`status-${id}`);
                const loader = document.getElementById(`loader-${id}`);
                
                loader.classList.add('hidden');
                statusDiv.innerHTML = `
                    <span class="text-xs bg-red-100 text-red-600 px-2 py-1 rounded-full">
                        <i class="fa-solid fa-circle-exclamation"></i> 錯誤: ${error.message || "無法處理"}
                    </span>
                `;
            }
        }

        function convertToDataUrl(fileOrBlob, format, quality) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = function(event) {
                    const img = new Image();
                    img.onload = function() {
                        const canvas = document.createElement('canvas');
                        canvas.width = img.width;
                        canvas.height = img.height;
                        const ctx = canvas.getContext('2d');
                        
                        // Handle transparency for JPEG (fill white)
                        if (format === 'image/jpeg') {
                            ctx.fillStyle = '#FFFFFF';
                            ctx.fillRect(0, 0, canvas.width, canvas.height);
                        }
                        
                        ctx.drawImage(img, 0, 0);
                        
                        try {
                            const dataUrl = canvas.toDataURL(format, quality);
                            resolve(dataUrl);
                        } catch (e) {
                            reject(e);
                        }
                    };
                    img.onerror = () => reject(new Error("無法載入圖片資料"));
                    img.src = event.target.result;
                };
                reader.onerror = () => reject(new Error("檔案讀取失敗"));
                reader.readAsDataURL(fileOrBlob);
            });
        }

        // --- Utilities ---
        function removeCard(id) {
            const card = document.getElementById(id);
            if (card) {
                card.remove();
                updateCount();
            }
        }

        clearAllBtn.addEventListener('click', () => {
            imageList.innerHTML = '';
            resultsArea.classList.add('hidden');
            updateCount();
        });

        function updateCount() {
            const count = imageList.children.length;
            countBadge.innerText = count;
            if (count === 0) resultsArea.classList.add('hidden');
        }

        function formatBytes(bytes, decimals = 1) {
            if (!+bytes) return '0 Bytes';
            const k = 1024;
            const dm = decimals < 0 ? 0 : decimals;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))} ${sizes[i]}`;
        }
    </script>
</body>
</html>
